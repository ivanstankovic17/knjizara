meta {
  name: Knjige na stanju
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/books?in_stock=1&sort=price&per_page=5
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  bru.setVar("bookId", res.body.data[0].id);
}

tests {
  test("vraća najviše 5 knjiga, sve na stanju, po rastućoj ceni", function () {
    const books = res.body.data;
    expect(res.status).to.equal(200);
    expect(books.length).to.be.within(1, 5);
    books.forEach((b) => expect(b.in_stock).to.be.true);
    const prices = books.map((b) => b.price);
    expect(prices).to.deep.equal([...prices].sort((a, b) => a - b));
  });
}
