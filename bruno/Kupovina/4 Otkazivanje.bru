meta {
  name: Otkazivanje
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders/{{orderId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("porudžbina je otkazana", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("cancelled");
    expect(res.body.data.links).to.not.have.property("cancel");
  });
}
