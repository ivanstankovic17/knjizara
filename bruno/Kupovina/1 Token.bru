meta {
  name: Token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tokens
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "device_name": "bruno"
  }
}

script:post-response {
  // Token važi za sve sledeće zahteve u ovom pokretanju.
  bru.setVar("token", res.body.token);
}

tests {
  test("izdaje token sa rokom važenja", function () {
    expect(res.status).to.equal(201);
    expect(res.body.token).to.match(/^\d+\|/);
    expect(new Date(res.body.expires_at) > new Date()).to.be.true;
  });
}
