# Okruženje za Bruno i end-to-end testove (odeljci 14.7 i 14.9):
# posebna baza i server na portu 8001, da testovi ne menjaju razvojne podatke.
#   APP_ENV=e2e php artisan migrate:fresh --seed --force
#   APP_ENV=e2e php artisan serve --port=8001
APP_NAME=Knjizara
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sr_Latn_RS

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
LOG_CHANNEL=single

REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
