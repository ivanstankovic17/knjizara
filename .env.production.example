# Produkcija (odeljci 16.1 i 16.4). Kopirajte u .env.production, upišite
# tajne i pokrenite:
#   docker compose --env-file .env.production up -d --build
# .env.production se ne stavlja u git; na serveru je samo kod administratora.

APP_NAME=Knjizara
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8443
APP_LOCALE=sr
APP_FALLBACK_LOCALE=en

# Log ide na standardni izlaz kontejnera, odakle ga čita Docker (16.7).
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=knjizara
DB_USERNAME=knjizara
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="knjizara@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel šalje događaje Reverbu unutar Docker mreže (reverb:8080), a
# pregledač se povezuje spolja, preko nginx-a (wss://localhost:8443/app).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
WEBSOCKET_ORIGIN=wss://localhost:8443

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
